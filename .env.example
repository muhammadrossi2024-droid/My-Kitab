# Firebase Web SDK config — from Firebase Console > Project settings > Your apps.
# Safe to expose client-side (not a secret) but still loaded via env vars,
# not hardcoded, so real values never end up committed to source.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
